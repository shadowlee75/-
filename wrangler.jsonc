{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shop-classroom",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shop-classroom-db"
    }
  ]
}
