{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shop-classroom",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shop-classroom-db",
      "database_id": "87160278-151a-4a86-9283-d35f4ff816fa"
    }
  ]
}
